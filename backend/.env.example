# Application Environment
APP_NAME="UK Energy Day-Ahead Purchasing Analytics"
APP_VERSION="1.0.0"
APP_ENVIRONMENT=development
APP_DEBUG=false

# Elexon BMRS API Settings
APP_ELEXON_API_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
APP_ELEXON_API_KEY=""
APP_ENABLE_LIVE_ELEXON_FETCH=false
APP_ELEXON_TIMEOUT_SECONDS=10.0

# Grid & Demand Simulation Parameters (UK Winter Reference)
APP_NOMINAL_WIND_CAPACITY_MW=30500.0
APP_BASE_DEMAND_MIN_MW=22000.0
APP_BASE_DEMAND_MAX_MW=44500.0
APP_DAY_AHEAD_GATE_CUTOFF_HOUR=11

